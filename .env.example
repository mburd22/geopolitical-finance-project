# Copy this file to one named .env (in the same folder) and fill in what you need.
# .env is listed in .gitignore, so your key never gets uploaded anywhere.

# Optional: lets Claude classify news events (much more accurate than keyword rules),
# turn headlines into tags, and write theses.
ANTHROPIC_API_KEY=

# The API server checks the news in the background. Set to 0 to turn that off.
AUTO_PIPELINE=1
# How often to check, in minutes.
PIPELINE_EVERY_MINUTES=60
